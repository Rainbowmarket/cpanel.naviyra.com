# Naviyra Security Manager — Backend
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8090

# JWT (min 32 chars)
JWT_SECRET=change-this-to-a-long-random-secret-key-32chars
JWT_TTL=86400

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naviyra_security
DB_USER=naviyra_sec
DB_PASS=your_secure_password

# Firewall (requires root for ufw/iptables)
FIREWALL_METHOD=ufw
FIREWALL_DRY_RUN=true
NGINX_DENY_FILE=/etc/nginx/naviyra-blocked-ips.conf

# Ingest API key (log parser / beacon)
INGEST_API_KEY=change-this-ingest-key

# GeoIP (optional path to GeoLite2-Country.mmdb)
GEOIP_DB_PATH=

# Auto-block after N threats from same IP within window (minutes)
AUTO_BLOCK_THRESHOLD=5
AUTO_BLOCK_WINDOW_MINUTES=15

# Live visitor timeout (seconds)
LIVE_VISITOR_TTL=300

# CORS — set to your React dashboard origin. Leave empty for same-origin only.
# Never use * with credentialed admin cookies.
CORS_ORIGIN=http://127.0.0.1:5174
