# Naviyra Panel — copy to .env and edit as needed

PANEL_PORT=3000
AGENT_PORT=4000

# REQUIRED in production: strong random secrets (openssl rand -hex 32)
# Never use naviyra-local-agent-key outside local dry-run experiments.
AGENT_API_KEY=
SESSION_SECRET=
# AES-256 key for encrypting TOTP secrets (openssl rand -hex 32)
TWO_FACTOR_ENC_KEY=

# Bind agent to loopback only (recommended). Wildcard bind is refused unless:
# AGENT_ALLOW_REMOTE=true
AGENT_BIND_HOST=127.0.0.1
AGENT_URL=http://127.0.0.1:4000

# Rotate secrets: sudo bash scripts/rotate-secrets.sh
# Optional: SECURITY_MANAGER_URL=http://127.0.0.1:8090
# (panel blocklist is source of truth; SM is mirrored)

# Windows: true (simulated). Linux production: false
AGENT_DRY_RUN=true

# Weak/default AGENT_API_KEY is allowed only when NODE_ENV=development.
# Unset NODE_ENV is treated as production. systemd sets NODE_ENV=production.
# NODE_ENV=development

# Your server's public IPv4 for DNS A records
SERVER_PUBLIC_IP=127.0.0.1

# Production deploy from this machine: npm run deploy
# Prefer SSH keys: leave DEPLOY_PASSWORD empty.
# Password auth: Windows needs PuTTY ≥ 0.78 (-pwfile); Linux/macOS uses sshpass -e.
DEPLOY_HOST=127.0.0.1
DEPLOY_USER=root
DEPLOY_PASSWORD=
DEPLOY_PORT=22

# Panel hostname (control UI). Use a real subdomain — never leave yourdomain.com
# (that string is a docs example and is ignored at runtime).
#   PANEL_HOSTNAME=hpanel.yourdomain.com
#   PANEL_PUBLIC_URL=https://hpanel.yourdomain.com
# Nameservers stay on the zone apex (ns1.yourdomain.com), not ns1.hpanel.yourdomain.com.
PANEL_HOSTNAME=hpanel.yourdomain.com
PANEL_PUBLIC_URL=https://hpanel.yourdomain.com

# DNS nameservers (defaults to ns1/ns2.{zone apex} when unset)
DNS_NS1=ns1.yourdomain.com
DNS_NS2=ns2.yourdomain.com
# Optional secondary server hostname (shown on SSL with DEFAULT_SERVER_HOSTNAME / Server rows)
# SECONDARY_SERVER_HOSTNAME=s2.yourdomain.com
DEFAULT_SERVER_HOSTNAME=s1.yourdomain.com

# Mail hostname template — deploy provisions this host for the zone apex
# (nginx webmail proxy + Let's Encrypt when public DNS A points at SERVER_PUBLIC_IP)
MAIL_HOSTNAME=mail.{domain}

# System mail From (password reset AND admin alerts). Domain MUST have a public SPF record
# that includes this server IP, or Gmail will reject (550 5.7.26).
# Prefer an address on a domain this panel hosts (or panel domain with SPF):
MAIL_FROM=noreply@yourdomain.com
#
# Admin alert emails go to every ADMIN user (and users in a group with the admin permission).
# Requires Linux /usr/sbin/sendmail (Postfix). Not sent on Windows.
# ADMIN_ALERTS_ENABLED=true
# Repeat of the same alert is suppressed for this many milliseconds (default 1 hour).
# ADMIN_ALERT_COOLDOWN_MS=3600000
# Host alerts run via naviyra-host-alerts.timer (hourly), not on dashboard page load.
# Security alerts (new public ports + root SSH logins) run every minute via
# naviyra-security-alerts.timer and email all admin users. First run records a
# baseline (no email). A port that closes and later re-opens is treated as new.
#
# Panel web sessions expire after 30 minutes without use (cookie + auto logout).
#
# If PANEL_HOSTNAME DNS is on Cloudflare (not ns1/ns2), also add:
#   A   mail   SERVER_PUBLIC_IP   (DNS only / grey cloud)
#   TXT @      v=spf1 ip4:SERVER_PUBLIC_IP a mx ~all

# Lock mailbox after this many wrong webmail passwords (timed lockout, not permanent).
# MAIL_MAX_FAILED_LOGINS=3
# MAIL_LOCKOUT_MS=900000

# Virtual mailbox root used by Postfix/Dovecot and panel webmail
# MAIL_VHOSTS_DIR=/var/mail/vhosts

# BIND integration (Linux production — run scripts/install-bind.sh)
BIND_ZONES_DIR=/etc/bind/zones
BIND_NAMED_DIR=/etc/bind/naviyra-zones.d
BIND_INCLUDE_FILE=/etc/bind/naviyra-zones.conf
BIND_RELOAD_CMD="rndc reload"

# Set true on headless servers
# NAVIYRA_NO_BROWSER=true

# Cookies: Secure flag. Leave unset to auto-enable when PANEL_PUBLIC_URL is https://
# (or NODE_ENV=production). Set false only for local HTTP testing.
# COOKIE_SECURE=true
# COOKIE_SECURE=false

# Trust nginx X-Real-IP / X-Forwarded-Proto (default false — spoofable if PANEL_PORT
# is public). Set true only behind a proxy that overwrites these from $remote_addr.
# Production installs with nginx should set TRUST_PROXY=true and keep :3100 off the internet.
# TRUST_PROXY=true

# Web Terminal WebSocket (production). Defaults to wss://{PANEL_HOSTNAME}/terminal-ws/terminal after first login.
# NEXT_PUBLIC_TERMINAL_WS_URL=wss://yourdomain.com/terminal-ws/terminal

# Backup worker (systemd timer → panel API). Defaults to AGENT_API_KEY when unset.
# BACKUP_WORKER_TOKEN=

# Optional dedicated key for /api/security/ingest (defaults to AGENT_API_KEY)
# SECURITY_INGEST_KEY=

# Visitor logs: separate monthly SQLite files under data/visitors/ (YYYY-MM.db).
# Older months are deleted automatically after VISITOR_RETENTION_MONTHS (default 6).
# VISITOR_DATA_DIR=data/visitors
# VISITOR_RETENTION_MONTHS=6

# Auto-blocks (source=auto) are removed after this many hours. Manual blocks never expire.
# AUTO_BLOCK_TTL_HOURS=48

# Let's Encrypt contact email (defaults to admin@{PANEL_HOSTNAME})
# LETSENCRYPT_EMAIL=admin@yourdomain.com

# Customer PostgreSQL (managed DBs). Host stays localhost; port may be 5433 if 5432 is taken.
# CUSTOMER_POSTGRES_HOST=127.0.0.1
# CUSTOMER_POSTGRES_PORT=5432

# Customer MySQL / MariaDB (phpMyAdmin Browse on panel host /_pma/).
# CUSTOMER_MYSQL_HOST=127.0.0.1
# CUSTOMER_MYSQL_PORT=3306
# PHPMYADMIN_DIR=/opt/naviyra-panel/phpmyadmin
# PHPMYADMIN_URL_PATH=/_pma
# NAVIYRA_PMA_TOKEN_DIR=/opt/naviyra-panel/data/pma-tokens
# PHP_FPM_SOCKET=/run/php/php8.3-fpm.sock

# PostgreSQL Browse via phpPgAdmin (panel host /_ppa/).
# Uses PHP 8 fork by default (ReimuHakurei/phpPgAdmin).
# PHPPGADMIN_DIR=/opt/naviyra-panel/phppgadmin
# PHPPGADMIN_URL_PATH=/_ppa
# PHPPGADMIN_REPO=https://github.com/ReimuHakurei/phpPgAdmin
# PHPPGADMIN_REF=master
# NAVIYRA_PPA_TOKEN_DIR=/opt/naviyra-panel/data/ppa-tokens

DATABASE_URL=file:./data/naviyra.db
