generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  RESELLER
  USER
}

enum DomainStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ERROR
}

enum SslStatus {
  NONE
  PENDING
  ACTIVE
  EXPIRED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum JobType {
  CREATE_DOMAIN
  DELETE_DOMAIN
  CREATE_SUBDOMAIN
  DELETE_SUBDOMAIN
  ISSUE_SSL
  RENEW_SSL
  CREATE_MAIL_ACCOUNT
  DELETE_MAIL_ACCOUNT
  CREATE_FTP_ACCOUNT
  DELETE_FTP_ACCOUNT
  SYNC_DNS
  BLOCK_IP
  UNBLOCK_IP
}

enum ThreatType {
  SQL_INJECTION
  XSS
  BRUTE_FORCE
  SCANNER
  BOT
  PATH_TRAVERSAL
  OTHER
}

enum ThreatSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityAction {
  LOGGED
  BLOCKED
  BLOCKED_AUTO
}

enum TerminalMode {
  FULL
  JAIL
}

enum TerminalLogKind {
  CMD
  OUT
  SYS
}

enum AppType {
  STATIC
  PHP
  PYTHON
  GO
  NODE
}

enum AppStatus {
  STOPPED
  RUNNING
  ERROR
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  name                  String
  passwordHash          String
  role                  UserRole @default(USER)
  sessionVersion        Int      @default(0)
  twoFactorEnabled      Boolean  @default(false)
  twoFactorSecret       String?
  twoFactorPendingSecret String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  domains          Domain[]
  jobs             Job[]
  terminalSessions TerminalSession[]
  passwordResets   PasswordResetToken[]
  backupCodes      BackupCode[]
  groupMemberships PanelGroupMember[]
}

model PanelGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PanelGroupPermission[]
  members     PanelGroupMember[]
}

model PanelGroupPermission {
  id      String @id @default(cuid())
  key     String
  groupId String
  group   PanelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
  @@index([key])
}

model PanelGroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String
  group   PanelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model BackupCode {
  id        String    @id @default(cuid())
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Server {
  id        String   @id @default(cuid())
  name      String
  hostname  String   @unique
  ipAddress String
  agentKey  String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains Domain[]
  jobs    Job[]
}

model Domain {
  id           String       @id @default(cuid())
  name         String       @unique
  documentRoot String
  status       DomainStatus @default(PENDING)
  phpEnabled   Boolean      @default(true)
  appType      AppType      @default(PHP)
  startCommand String?
  appStartupFile String?
  appWorkingDir String      @default(".")
  upstreamPort Int?
  appStatus    AppStatus    @default(STOPPED)
  appEnv       String?
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  subdomains   Subdomain[]
  mailDomain   MailDomain?
  ftpAccounts  FtpAccount[]
  postgresDatabases PostgresDatabase[]
  sslCerts     SslCertificate[]
  dnsZone      DnsZone?
  visitorLogs  VisitorLog[]
  liveVisitors LiveVisitor[]
  securityEvents SecurityEvent[]
}

model Subdomain {
  id           String       @id @default(cuid())
  name         String
  documentRoot String
  status       DomainStatus @default(PENDING)
  appType      AppType      @default(PHP)
  startCommand String?
  appStartupFile String?
  appWorkingDir String      @default(".")
  upstreamPort Int?
  appStatus    AppStatus    @default(STOPPED)
  appEnv       String?
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  sslCerts SslCertificate[]

  @@unique([domainId, name])
}

model MailDomain {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domainId String @unique
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  accounts MailAccount[]
  aliases  MailAlias[]
}

model MailAccount {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  quotaMb          Int       @default(1024)
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  mailDomainId String
  mailDomain   MailDomain @relation(fields: [mailDomainId], references: [id], onDelete: Cascade)
}

model MailAlias {
  id        String   @id @default(cuid())
  alias     String   @unique
  forwardTo String
  createdAt DateTime @default(now())

  mailDomainId String
  mailDomain   MailDomain @relation(fields: [mailDomainId], references: [id], onDelete: Cascade)
}

model FtpAccount {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  homeDir      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model PostgresDatabase {
  id           String   @id @default(cuid())
  label        String
  dbName       String   @unique
  roleName     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model SslCertificate {
  id        String    @id @default(cuid())
  provider  String    @default("letsencrypt")
  status    SslStatus @default(PENDING)
  issuedAt  DateTime?
  expiresAt DateTime?
  autoRenew Boolean   @default(true)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  subdomainId String?
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id], onDelete: Cascade)

  @@index([domainId, status])
  @@index([subdomainId, status])
}

model DnsZone {
  id        String    @id @default(cuid())
  serial    Int       @default(1)
  syncedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  domainId String @unique
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  records DnsRecord[]
}

model DnsRecord {
  id       String @id @default(cuid())
  name     String
  type     String @default("A")
  value    String
  ttl      Int    @default(86400)
  priority Int?

  zoneId String
  zone   DnsZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, name, type, value])
  @@index([zoneId])
}

model Job {
  id        String    @id @default(cuid())
  type      JobType
  status    JobStatus @default(QUEUED)
  payload   Json
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  serverId String?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model VisitorLog {
  id          String   @id @default(cuid())
  ipAddress   String
  url         String
  method      String   @default("GET")
  userAgent   String?
  browser     String?
  os          String?
  countryCode String?
  countryName String?
  referrer    String?
  statusCode  Int?
  isBot       Boolean  @default(false)
  visitedAt   DateTime @default(now())

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, visitedAt])
  @@index([ipAddress])
  @@index([visitedAt])
}

model LiveVisitor {
  id          String   @id @default(cuid())
  ipAddress   String
  url         String?
  browser     String?
  countryCode String?
  lastSeen    DateTime @default(now()) @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, ipAddress])
  @@index([lastSeen])
}

model SecurityEvent {
  id          String          @id @default(cuid())
  ipAddress   String
  threatType  ThreatType
  severity    ThreatSeverity  @default(MEDIUM)
  url         String?
  payload     String?
  userAgent   String?
  statusCode  Int?
  actionTaken SecurityAction  @default(LOGGED)
  detectedAt  DateTime        @default(now())

  domainId String?
  domain   Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  blockedIp BlockedIp?

  @@index([ipAddress, detectedAt])
  @@index([detectedAt])
}

model BlockedIp {
  id          String   @id @default(cuid())
  ipAddress   String   @unique
  reason      String
  source      String   @default("manual")
  blockedVia  String   @default("ufw")
  isActive    Boolean  @default(true)
  blockedAt   DateTime @default(now())

  securityEventId String?        @unique
  securityEvent   SecurityEvent? @relation(fields: [securityEventId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

model WhitelistedIp {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model TerminalSession {
  id          String       @id @default(cuid())
  mode        TerminalMode
  cwd         String
  targetLabel String?
  createdAt   DateTime     @default(now())
  endedAt     DateTime?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs TerminalSessionLog[]

  @@index([userId, createdAt])
}

model TerminalSessionLog {
  id   String          @id @default(cuid())
  at   DateTime        @default(now())
  kind TerminalLogKind
  text String

  sessionId String
  session   TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
}

enum BackupSchedule {
  EVERY_6H
  DAILY_02
  DAILY_03
  WEEKLY_SUN
}

model PanelServerConfig {
  id            String   @id @default("default")
  maxUploadMb   Int      @default(512)
  nginxApplied  Boolean  @default(false)
  lastError     String?
  updatedAt     DateTime @updatedAt
}

model BackupWorkerConfig {
  id             String         @id @default("default")
  enabled        Boolean        @default(false)
  schedule       BackupSchedule @default(DAILY_03)
  retainCount    Int            @default(7)
  includePanelDb    Boolean        @default(true)
  includeSites      Boolean        @default(true)
  includeDns        Boolean        @default(true)
  includeMail       Boolean        @default(false)
  includeDatabases  Boolean        @default(true)
  backupRoot        String         @default("/var/backups/naviyra")
  timerInstalled Boolean        @default(false)
  lastRunAt      DateTime?
  lastStatus     JobStatus?
  lastError      String?
  lastArchive    String?
  updatedAt      DateTime       @updatedAt
}

model BackupRun {
  id          String    @id @default(cuid())
  status      JobStatus @default(QUEUED)
  source      String    @default("manual")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  archivePath String?
  sizeBytes   Int?
  error       String?
  summary     String?

  @@index([startedAt])
}
