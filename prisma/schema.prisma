generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  RESELLER
  USER
}

enum DomainStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ERROR
}

enum SslStatus {
  NONE
  PENDING
  ACTIVE
  EXPIRED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum JobType {
  CREATE_DOMAIN
  DELETE_DOMAIN
  CREATE_SUBDOMAIN
  DELETE_SUBDOMAIN
  ISSUE_SSL
  RENEW_SSL
  CREATE_MAIL_ACCOUNT
  DELETE_MAIL_ACCOUNT
  CREATE_FTP_ACCOUNT
  DELETE_FTP_ACCOUNT
  SYNC_DNS
  BLOCK_IP
  UNBLOCK_IP
}

enum ThreatType {
  SQL_INJECTION
  XSS
  BRUTE_FORCE
  SCANNER
  BOT
  PATH_TRAVERSAL
  OTHER
}

enum ThreatSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityAction {
  LOGGED
  BLOCKED
  BLOCKED_AUTO
}

enum TerminalMode {
  FULL
  JAIL
}

enum TerminalLogKind {
  CMD
  OUT
  SYS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domains          Domain[]
  jobs             Job[]
  terminalSessions TerminalSession[]
}

model Server {
  id        String   @id @default(cuid())
  name      String
  hostname  String   @unique
  ipAddress String
  agentKey  String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains Domain[]
  jobs    Job[]
}

model Domain {
  id           String       @id @default(cuid())
  name         String       @unique
  documentRoot String
  status       DomainStatus @default(PENDING)
  phpEnabled   Boolean      @default(true)
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  subdomains   Subdomain[]
  mailDomain   MailDomain?
  ftpAccounts  FtpAccount[]
  sslCerts     SslCertificate[]
  dnsZone      DnsZone?
  visitorLogs  VisitorLog[]
  liveVisitors LiveVisitor[]
  securityEvents SecurityEvent[]
}

model Subdomain {
  id           String       @id @default(cuid())
  name         String
  documentRoot String
  status       DomainStatus @default(PENDING)
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  sslCerts SslCertificate[]

  @@unique([domainId, name])
}

model MailDomain {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domainId String @unique
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  accounts MailAccount[]
  aliases  MailAlias[]
}

model MailAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  quotaMb      Int      @default(1024)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mailDomainId String
  mailDomain   MailDomain @relation(fields: [mailDomainId], references: [id], onDelete: Cascade)
}

model MailAlias {
  id        String   @id @default(cuid())
  alias     String   @unique
  forwardTo String
  createdAt DateTime @default(now())

  mailDomainId String
  mailDomain   MailDomain @relation(fields: [mailDomainId], references: [id], onDelete: Cascade)
}

model FtpAccount {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  homeDir      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model SslCertificate {
  id        String    @id @default(cuid())
  provider  String    @default("letsencrypt")
  status    SslStatus @default(PENDING)
  issuedAt  DateTime?
  expiresAt DateTime?
  autoRenew Boolean   @default(true)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  subdomainId String?
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id], onDelete: Cascade)

  @@index([domainId, status])
  @@index([subdomainId, status])
}

model DnsZone {
  id        String    @id @default(cuid())
  serial    Int       @default(1)
  syncedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  domainId String @unique
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  records DnsRecord[]
}

model DnsRecord {
  id       String @id @default(cuid())
  name     String
  type     String @default("A")
  value    String
  ttl      Int    @default(86400)
  priority Int?

  zoneId String
  zone   DnsZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, name, type, value])
  @@index([zoneId])
}

model Job {
  id        String    @id @default(cuid())
  type      JobType
  status    JobStatus @default(QUEUED)
  payload   Json
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  serverId String?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model VisitorLog {
  id          String   @id @default(cuid())
  ipAddress   String
  url         String
  method      String   @default("GET")
  userAgent   String?
  browser     String?
  os          String?
  countryCode String?
  countryName String?
  referrer    String?
  statusCode  Int?
  isBot       Boolean  @default(false)
  visitedAt   DateTime @default(now())

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, visitedAt])
  @@index([ipAddress])
  @@index([visitedAt])
}

model LiveVisitor {
  id          String   @id @default(cuid())
  ipAddress   String
  url         String?
  browser     String?
  countryCode String?
  lastSeen    DateTime @default(now()) @updatedAt

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, ipAddress])
  @@index([lastSeen])
}

model SecurityEvent {
  id          String          @id @default(cuid())
  ipAddress   String
  threatType  ThreatType
  severity    ThreatSeverity  @default(MEDIUM)
  url         String?
  payload     String?
  userAgent   String?
  statusCode  Int?
  actionTaken SecurityAction  @default(LOGGED)
  detectedAt  DateTime        @default(now())

  domainId String?
  domain   Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  blockedIp BlockedIp?

  @@index([ipAddress, detectedAt])
  @@index([detectedAt])
}

model BlockedIp {
  id          String   @id @default(cuid())
  ipAddress   String   @unique
  reason      String
  source      String   @default("manual")
  blockedVia  String   @default("ufw")
  isActive    Boolean  @default(true)
  blockedAt   DateTime @default(now())

  securityEventId String?        @unique
  securityEvent   SecurityEvent? @relation(fields: [securityEventId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

model WhitelistedIp {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model TerminalSession {
  id          String       @id @default(cuid())
  mode        TerminalMode
  cwd         String
  targetLabel String?
  createdAt   DateTime     @default(now())
  endedAt     DateTime?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs TerminalSessionLog[]

  @@index([userId, createdAt])
}

model TerminalSessionLog {
  id   String          @id @default(cuid())
  at   DateTime        @default(now())
  kind TerminalLogKind
  text String

  sessionId String
  session   TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
}
