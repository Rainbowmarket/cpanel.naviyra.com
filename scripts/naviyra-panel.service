[Unit]
Description=Naviyra Hosting Control Panel
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/naviyra-panel
Environment=PATH=__NODE_BIN_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
Environment=AGENT_DRY_RUN=false
Environment=NAVIYRA_NO_BROWSER=true
EnvironmentFile=-/opt/naviyra-panel/.env
Environment=HOSTNAME=0.0.0.0
ExecStart=__NODE_BIN__ launcher/index.mjs start --no-browser
ExecStop=__NODE_BIN__ launcher/stop.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
