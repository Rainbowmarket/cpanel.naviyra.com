[Unit]
Description=Naviyra Panel Backup Worker
After=network.target naviyra-panel.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/opt/naviyra-panel/.env
Environment=PANEL_PORT=3100
ExecStart=/opt/naviyra-panel/scripts/backup-worker.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
